---
import Base from '../layouts/Base.astro';
import { SITE_TITLE } from '../consts';

interface Project {
  name: string;
  tagline: string;
  install?: string;
  repo: string;
  site?: string;
  link: { label: string; href: string };
}

const projects: Project[] = [
  {
    name: 'Brewy',
    tagline:
      'A native macOS GUI for Homebrew. Browse, search, install, and update formulae and casks without opening your terminal.',
    install: 'brew install brewy',
    repo: 'https://github.com/starhaven-io/Brewy',
    link: { label: 'Brewy releases', href: 'https://github.com/starhaven-io/Brewy/releases' },
  },
  {
    name: 'macOSdb',
    tagline:
      'A catalog of which versions of open-source components ship with each macOS and Xcode release. Includes curl, OpenSSH, LibreSSL, Swift, Apple Clang, and more.',
    install: 'brew install starhaven-io/tap/macosdb',
    repo: 'https://github.com/starhaven-io/macOSdb',
    site: 'https://macosdb.com/',
    link: { label: 'Compare macOS releases', href: 'https://macosdb.com/macos/compare/' },
  },
  {
    name: 'midden',
    tagline:
      "A CLI that resolves, audits, visualizes, and cleans the heap of context and state Codex and Claude Code accumulate. Surfaces what's actually active for a directory with provenance, flags what's stale or leaking, and prunes what nothing else cleans up.",
    install: 'brew install starhaven-io/tap/midden',
    repo: 'https://github.com/starhaven-io/midden',
    link: { label: 'midden CLI guide', href: 'https://github.com/starhaven-io/midden#usage' },
  },
  {
    name: 'pinprick',
    tagline:
      'Supply-chain security for GitHub Actions. Pins action references to full SHAs and audits pinned actions for runtime fetches that bypass pinning.',
    install: 'brew install starhaven-io/tap/pinprick',
    repo: 'https://github.com/starhaven-io/pinprick',
    site: 'https://pinprick.rs/',
    link: { label: 'Use the GitHub Action', href: 'https://github.com/starhaven-io/pinprick-action' },
  },
  {
    name: 'pkgstory',
    tagline:
      "The version history of every Homebrew formula and cask — which version shipped, and when — mined from git history into a browsable timeline. Deprecations and removals are recorded with the date and Homebrew's own reason.",
    repo: 'https://github.com/starhaven-io/pkgstory',
    site: 'https://pkgstory.dev/',
    link: { label: 'Explore Git’s package history', href: 'https://pkgstory.dev/homebrew-formula/git/' },
  },
  {
    name: 'rakkan',
    tagline: 'Tracks trusted publishing adoption across package registries using provenance accepted by each registry.',
    repo: 'https://github.com/starhaven-io/rakkan',
    site: 'https://rakkan.dev/',
    link: { label: 'Browse RubyGems packages', href: 'https://rakkan.dev/packages/' },
  },
];
---

<Base title={SITE_TITLE}>
  <section class="intro">
    <h1>Hi, I'm Patrick.</h1>
    <p class="lede">
      I maintain Homebrew and build open-source tools for macOS and developer workflows, mostly via agentic coding. This
      site is where they live, plus the occasional <a href="/blog/">write-up</a>.
    </p>
  </section>

  <section aria-labelledby="projects-heading">
    <h2 id="projects-heading">Projects</h2>
    <ul class="project-list" role="list">
      {projects.map((project) => (
        <li class="project">
          <div class="project-heading">
            <h3>
              <a href={project.site ?? project.repo}>{project.name}</a>
            </h3>
            {project.site && (
              <a class="source" href={project.repo} aria-label={`${project.name} source code`}>
                Source code
              </a>
            )}
          </div>
          <p>{project.tagline}</p>
          <div class="project-actions">
            <a href={project.link.href}>{project.link.label}</a>
            {project.install && (
              <details>
                <summary>Install {project.name}</summary>
                <code>{project.install}</code>
              </details>
            )}
          </div>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .intro {
    padding-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  .lede {
    max-width: 56ch;
    margin: 0;
    font-size: 1.125rem;
  }

  .project-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 1rem 1.125rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg-secondary);
  }

  .project-heading,
  .project-actions {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }

  .project-heading {
    justify-content: space-between;
  }

  .project h3,
  .project p {
    margin: 0;
  }

  .project h3 {
    font-size: 1.25rem;
  }

  .project p {
    line-height: 1.45;
  }

  .source {
    color: var(--color-text-secondary);
    font-size: 0.8125rem;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .project-actions {
    margin-top: auto;
    font-size: 0.875rem;
  }

  .project-actions a {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .project-actions details[open] {
    flex-basis: 100%;
    min-width: 0;
  }

  .project-actions summary {
    width: fit-content;
    color: var(--color-text-secondary);
    cursor: pointer;
  }

  .project-actions code {
    display: block;
    margin-top: 0.35rem;
    padding: 0.35rem 0.5rem;
    overflow-wrap: anywhere;
    background: var(--color-bg);
    font-size: 0.8125rem;
  }
</style>
