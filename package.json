{
  "name": "starhaven.io",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "node scripts/deploy-site.mjs",
    "deploy:dry": "wrangler deploy --config dist/client/wrangler.json --dry-run",
    "test": "node --test 'tests/**/*.test.mjs'",
    "test:smoke": "node scripts/smoke-test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/markdown-satteri": "0.4.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5",
    "markdown-it": "^15.0.2",
    "sanitize-html": "^2.18.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/markdown-it": "^14.2.0",
    "@types/sanitize-html": "^2.16.2",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6.0.3",
    "wrangler": "4.147.0"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false,
    "workerd": false
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
